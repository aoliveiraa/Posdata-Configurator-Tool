      <Parameter name="OrderNumberFormat" value="2"/>
      <Parameter name="OrderIdFormat" value="00"/>
      <Parameter name="OrderNumberSeperator" value=""/>
    </Section>
  </Configuration>
  <Services>
    <Service name="1023" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="RPR">
          <Member name="1023" alias=""/>
        </UsedService>
      </UsedServices>
      <Configuration imports="KVSRedesign">
        <Section name="UserInterface">
          <Parameter name="groupMultiOrder" value="false"/>
          <Parameter name="OrderIDDigits" value="2"/>
          <Parameter name="RegisterMapping" value="4,1|5,1|6,1|7,1|8,1|9,1|10,1|11,1|12,1|13,4|14,1|15,1|19,3|20,3|21,3|22,3|23,3|24,3|25,2|26,2|27,2|28,2|29,2|30,2|31,2|32,2|33,2|34,2|35,2|36,2|37,2|38,2|39,2|40,2|51,1|52,4|54,2|55,1|300,1"/>
