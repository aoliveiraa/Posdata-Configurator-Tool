        <Section name="WayOfWork">
          <Parameter name="printReceiptOnServe" value="false"/>
          <Parameter name="monitorType" value="OATPresenter"/>
        </Section>
        <Section name="TouchScreen">
          <Parameter name="button5_Click" value="toggleSideOnOff"/>
          <Parameter name="cell_Click" value="globalserve"/>
          <Parameter name="available" value="true"/>
          <Parameter name="enable" value="true"/>
        </Section>
        <Section name="EnhancedBumpByTouch">
          <Parameter name="enhancedBumpByTouchEnable" value="true"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true"/>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true">
          <Section name="main">
            <Parameter name="kvsUIPort" value="1023"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true"/>
        <Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="false">
          <Section name="main">
            <Parameter name="globalserve" value="0xe1"/>
            <Parameter name="recall" value="0xa1"/>
            <Parameter name="print" value="0xa2"/>
            <Parameter name="next" value="0xb1"/>
            <Parameter name="previous" value="0xb2"/>
            <Parameter name="home" value=""/>
            <Parameter name="serveheld" value=""/>
            <Parameter name="heldscroll" value="0xe2"/>
            <Parameter name="undo" value=""/>
            <Parameter name="zoom" value="0xd1"/>
            <Parameter name="SideOn" value="0xc2"/>
            <Parameter name="SideOff" value="0xc1"/>
            <Parameter name="logicalname" value="BumpBar7"/>
            <Parameter name="isNpSharp" value="true"/>
            <Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
    <Service name="1033" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="RPR">
          <Member name="1033" alias=""/>
        </UsedService>
      </UsedServices>
      <Configuration imports="KVSRedesign">
        <Section name="UserInterface">
          <Parameter name="groupMultiOrder" value="true"/>
          <Parameter name="displaySideIndicator" value="true"/>
        </Section>
        <Section name="WayOfWork">
          <Parameter name="monitorType" value="OAT"/>
          <Parameter name="printReceiptOnServe" value="true"/>
        </Section>
        <Section name="Touchscreen">
          <Parameter name="enable" value="true"/>
          <Parameter name="available" value="true"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true"/>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true">
          <Section name="main">
            <Parameter name="kvsUIPort" value="1033"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true"/>
        <Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="false">
          <Section name="main">
            <Parameter name="serve1" value="0xe1"/>
            <Parameter name="serve2" value="0xd1"/>
            <Parameter name="serve3" value="0xb1"/>
            <Parameter name="serve4" value="0xa1"/>
            <Parameter name="next" value="0xc1"/>
            <Parameter name="serve5" value="0xe2"/>
            <Parameter name="serve6" value="0xd2"/>
            <Parameter name="serve7" value="0xb2"/>
            <Parameter name="serve8" value="0xa2"/>
            <Parameter name="recall" value="0xc2"/>
            <Parameter name="logicalname" value="BumpBar7"/>
            <Parameter name="isNpSharp" value="true"/>
            <Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
    <Service name="1023" type="NPW" classname="" startonload="true" quitOnFail="true">
      <Configuration imports="LocalWebView">
        <Section name="BaseHosts">
          <Parameter name="Urls" value="http://127.0.0.1:8123/npsharp/"/>
        </Section>
        <Section name="LocalWebView">
          <Parameter name="Location" value="../npwebview"/>
          <Parameter name="ConfigurationFileName" value="WebViewConfig.xml"/>
        </Section>
        <Section name="Log">
          <Parameter name="EnableDebug" value="true"/>
          <Parameter name="LogFileFolder" value="out/"/>
        </Section>
        <Section name="AutoUpdate">
          <Parameter name="EnableAutoUpdate" value="true"/>
        </Section>
        <Section name="Monitoring">
          <Parameter name="MonitorInterval" value="60000"/>
        </Section>
        <Section name="Monitoring.Memory">
          <Parameter name="MaxMemoryPercentage" value="80"/>
          <Parameter name="LauncherLimit" value="200"/>
          <Parameter name="BrowserLimit" value="1500"/>
          <Parameter name="DriverHostLimit" value="1500"/>
        </Section>
        <Section name="Component.DriverHost.Scanner">
          <Parameter name="DriverFile" value="SerialScanner.dll"/>
          <Parameter name="DeviceType" value="Scanner"/>
          <Parameter name="LogicalName" value="Scanner61"/>
          <Parameter name="NodeName" value="KVS1023"/>
