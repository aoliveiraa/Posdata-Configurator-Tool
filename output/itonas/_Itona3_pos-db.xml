        <Section name="Component.Browser.KVS1033">
          <Parameter name="Position" value="1024,0"/>
          <Parameter name="ShowFrame" value="true"/>
          <Parameter name="Urn" value="KVS/KVS1033"/>
          <Parameter name="ShowCursor" value="true"/>
          <Parameter name="Size" value="1024x768"/>
          <Parameter name="BrowserServer" value="messagehub"/>
          <!--Coordinator Config-->
          <Parameter name="NodeName" value="KVS1033"/>
          <Parameter name="LogicalName" value="KVS1033"/>
          <Parameter name="InjectJavascriptCode" value="ClickPOSButtonHelper,MessageHubResponseHelper"/>
          <!--Coordinator Config-->
        </Section>
      </Configuration>
    </Service>
