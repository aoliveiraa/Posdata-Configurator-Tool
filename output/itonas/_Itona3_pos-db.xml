<?xml version='1.0' encoding='UTF-8'?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="PrintOnServe">
      <Parameter name="DuplicateReceiptWithBarCode" value="0"/>
      <Parameter name="Picklist" value="1"/>
      <Parameter name="DuplicateReceipt" value="0"/>
      <Parameter name="PicklistWithBarCode" value="0"/>
