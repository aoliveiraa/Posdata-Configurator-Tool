<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide"/>
  <Services>
    <Service name="1011" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO"/>
    </Service>
    <Service name="1011" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <UsedServices></UsedServices>
      <Configuration imports="KVSRedesign">
        <Section name="Beep">
          <Parameter name="enabled" value="false"/>
        </Section>
        <Section name="UserInterface">
          <Parameter name="horizontalPos" value="0"/>
          <Parameter name="rows" value="2"/>
          <Parameter name="rows1" value="2"/>
          <Parameter name="rows2" value="2"/>
          <Parameter name="rows3" value="2"/>
          <Parameter name="columns" value="4"/>
          <Parameter name="columns1" value="4"/>
          <Parameter name="columns2" value="4"/>
          <Parameter name="columns3" value="4"/>
          <Parameter name="heldCells" value="3"/>
          <Parameter name="heldCells1" value="3"/>
          <Parameter name="heldCells2" value="3"/>
          <Parameter name="heldCells3" value="3"/>
          <Parameter name="orderItemFont" value="Arial-BOLD-15"/>
          <Parameter name="orderItemFont1" value="Arial-BOLD-15"/>
          <Parameter name="orderItemFont2" value="Arial-BOLD-15"/>
          <Parameter name="orderItemFont3" value="Arial-BOLD-15"/>
          <Parameter name="grillItemFont" value="Arial-BOLD-14"/>
          <Parameter name="grillItemFont1" value="Arial-BOLD-14"/>
          <Parameter name="grillItemFont2" value="Arial-BOLD-14"/>
          <Parameter name="grillItemFont3" value="Arial-BOLD-14"/>
          <Parameter name="orderItemVoidedFont" value="Arial-REGULAR-15"/>
          <Parameter name="orderItemVoidedFont1" value="Arial-REGULAR-15"/>
          <Parameter name="orderItemVoidedFont2" value="Arial-REGULAR-15"/>
          <Parameter name="orderItemVoidedFont3" value="Arial-REGULAR-15"/>
          <Parameter name="grillItemVoidedFont" value="Arial-REGULAR-14"/>
          <Parameter name="grillItemVoidedFont1" value="Arial-REGULAR-14"/>
          <Parameter name="grillItemVoidedFont2" value="Arial-REGULAR-14"/>
          <Parameter name="grillItemVoidedFont3" value="Arial-REGULAR-14"/>
          <Parameter name="firstThreshold" value="90"/>
          <Parameter name="secondThreshold" value="100"/>
          <Parameter name="displayGrillInstruction" value="ASTEXT"/>
          <Parameter name="displaySideIndicator" value="multiple"/>
          <Parameter name="displaySideStatus" value="false"/>
          <Parameter name="displayDestinationImage" value="true"/>
          <Parameter name="displaySaleType" value="true"/>
          <Parameter name="displayOrderAmount" value="false"/>
          <Parameter name="enhancementToMultiChannelFulfillment" value="true" />
          <Parameter name="displayPackaging" value="ASTEXT" />
          <Parameter name="bagPackagingBlank" value="true" />
          <Parameter name="displayFulfillmentLocation" value="ASTEXT" />
          <Parameter name="displayOrderSource" value="ASTEXT" />
        </Section>
        <Section name="WayOfWork">
          <Parameter name="printReceiptOnServe" value="false"/>
          <Parameter name="allowServeHeldOrders" value="true"/>
          <Parameter name="monitorType" value="OATPresenter"/>
        </Section>
        <Section name="Touchscreen">
          <Parameter name="enable" value="true"/>
          <Parameter name="available" value="true"/>
          <Parameter name="buttons" value="8"/>
          <Parameter name="cell_Click" value="serve"/>
          <Parameter name="button1_Click" value="serve" />
          <Parameter name="button2_Click" value="next" />
          <Parameter name="button3_Click" value="recall" />
          <Parameter name="button4_Click" value="sideOn" />
          <Parameter name="button5_Click" value="sideOff" />
          <Parameter name="button6_Click" value="zoom" />
          <Parameter name="button7_Click" value="hold" />
          <Parameter name="button8_Click" value="Held mode" />
          <Parameter name="button9_Click" value="serveheld" />
         <Parameter name="button10_Click" value="heldscroll" />
        </Section>
        <Section name="EnhancedBumpByTouch">
          <Parameter name="enhancedBumpByTouchEnable" value="true"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="npAdpKeyboardBumpBar" imports="npAdpKeyboardBumpBar" startonload="true"/>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true"/>
        <Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="true">
          <Section name="main">
            <Parameter name="logicalname" value="BUMPBAR1"/>
            <Parameter name="isNpSharp" value="true"/>
            <Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll"/>
            <Parameter name="hostAddress" value="localhost"/>
            <Parameter name="portNumber" value="8123"/>
            <Parameter name="serve" value="0xa1|0xa2"/>
            <Parameter name="zoom" value="0xb1"/>
            <Parameter name="recall" value="0xb2"/>
            <Parameter name="next" value="0xc1|0xc2"/>
            <Parameter name="sideon" value="0xe1"/>
            <Parameter name="sideoff" value="0xe2"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
  </Services>
</PosDB>
