<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="OperationMode">
      <Parameter name="applyUpdateOperationMode" value="1"/>
    </Section>
  </Configuration>
  <Services>
    <Service name="1043" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <Configuration imports="KVSRedesign">
        <Section name="UserInterface">
          <Parameter name="groupMultiOrder" value="false"/>
          <Parameter name="displaySideIndicator" value="true"/>
        </Section>
        <Section name="TouchScreen">
          <Parameter name="available" value="true"/>
          <Parameter name="enable" value="true"/>
          <Parameter name="cell_Click" value="serve"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true">
          <Section name="main">
            <Parameter name="url" value="http://127.0.0.1:8080/goform/RPC2"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true">
          <Section name="main">
            <Parameter name="kvsUIPort" value="1043"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true"/>
      </Adaptors>
    </Service>
    <Service name="1043" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO"/>
    </Service>
    <Service name="1043" type="RPR" classname="npRPR.dll" startonload="true" quitOnFail="true">
      <Adaptors>
        <Section name="main">
          <Parameter name="portname" value="RPR1043.txt"/>
          <Parameter name="escSeq" value="printerTMControlChar_STAR.properties"/>
          <Parameter name="logicalname" value="Printer1"/>
          <Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll"/>
          <Parameter name="isNpSharp" value="true"/>
        </Section>
      </Adaptors>
    </Service>
  </Services>
</PosDB>
