	<Service name="0101" type="NPW" classname="" startonload="true" quitOnFail="true">
      <Configuration imports="LocalWebView">
        <Section name="BaseHosts">
          <Parameter name="Urls" value="http://127.0.0.1:8123/npsharp" />
        </Section>
        <Section name="LocalWebView">
          <Parameter name="Location" value="../NpWebView" />
        </Section>
        <Section name="Log">
          <Parameter name="EnableDebug" value="true" />
          <Parameter name="LogFileFolder" value="out/" />
        </Section>
        <Section name="AutoUpdate">
          <Parameter name="EnableAutoUpdate" value="false" />
        </Section>
        <Section name="Monitoring.Memory">
          <Parameter name="MonitoringInterval" value="60000" />
          <Parameter name="MaxMemoryPercentage" value="80" />
          <Parameter name="LauncherLimit" value="1500" />
          <Parameter name="BrowserLimit" value="1500" />
          <Parameter name="DriverHostLimit" value="1500" />
        </Section>
        <Section name="Component.Browser.KVS1"> <!-- At least in laptop load this needs to be a different name for each POS/Kiosk -->
          <Parameter name="Position" value="2048,0" />
          <Parameter name="Urn" value="kvs/KVS0101" />
          <Parameter name="Zoom" value="100" />
          <Parameter name="ShowFrame" value="true" />
          <Parameter name="ShowCursor" value="true" />
          <Parameter name="Size" value="1024x768" />
          <Parameter name="canMoveWindow" value="true"/>
        </Section>
		<Section name="Component.DriverHost.Printer0101">
			<Parameter name="DeviceType" value="Printer" />
			<Parameter name="logicalName" value="GPR0101" />
			<Parameter name="nodeName" value="GPR0101" />
			<Parameter name="DriverFile" value="VirtualPrinter.dll" />
			<Parameter name="AdapterFile" value="LegacyPrinterAdapter" />
			<Parameter name="PortName" value="..\..\..\..\TEMPKVS1\GPR0101.txt" />
		</Section>
      </Configuration>
    </Service>
    <Service name="0101" type="GPR" classname="npRPR.dll" startonload="true" quitOnFail="false">
      <Adaptors>
        <Adaptor name="npAdpRpr" imports="npAdpRpr" startonload="true">
          <Section name="main">
			<Parameter name="isNpSharp" value="true" />
			<Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll" />
			<Parameter name="nodeName" value="KVS0001"/>
			<Parameter name="logicalname" value="GPR0101" />
			<!--don't need this for laptop load <Parameter name="portname" value="GPR0101.txt" />
            don't need this for laptop load <Parameter name="printerInitCode" value="28|67|1" />
            don't need this for laptop load <Parameter name="printerCutCode" value="27|109" />
            don't need this for laptop load <Parameter name="printerSleepTime" value="20" />-->
          </Section>
