<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all" />
  <ColorDB imports="default" />
  <Configuration imports="Store.wide">
    <Section name="OperationMode">
      <Parameter name="applyUpdateOperationMode" value="1" />
    </Section>
    <Section name="NPScripts">
      <Parameter name="posScriptCommands" />
      <Parameter name="posCoinDispenser" />
      <Parameter name="posCSOBusComp" />
      <Parameter name="scriptCommands" value="BusinessComponents.nps" />
      <Parameter name="scriptCommandsLocal" value="BusinessComponentsLocal.nps" />
    </Section>
    <Section name="OrderNumber">
      <Parameter name="PosIdFormat" value="0" />
      <Parameter name="OrderNumberBigger" value="1" />
      <Parameter name="OrderIdFormat" value="00" />
      <Parameter name="OrderNumberSeperator" />
      <Parameter name="OrderNumberFormat" value="2" />
      <Parameter name="FirstReceiptEmpty" value="0" />
    </Section>
    <Section name="Security">
      <Parameter name="managerAuthorization" value="login" />
    </Section>
    <Section name="OrbMatch">
      <Parameter name="ShowORBNumberOnReceipt" value="false" />
    </Section>
  </Configuration>
  <Services>
    <Service name="04" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO">
        <Section name="main">
          <Parameter name="SmartUpdateNodeName" value="ariane.medeiros" />
        </Section>
      </Configuration>
    </Service>
  </Services>
</PosDB>