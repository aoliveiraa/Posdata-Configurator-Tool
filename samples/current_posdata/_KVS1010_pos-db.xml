<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="NPScripts">
      <Parameter name="kvsServeReceipt" value="reportPickList@reportsLocal.nps"/>
      <Parameter name="kvsReceipt" value="receipt@reportsLocal.nps"/>
    </Section>
  </Configuration>
  <Services>
    <Service name="1010" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO"/>
    </Service>
    <Service name="1010" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <UsedServices></UsedServices>
      <Configuration imports="KVSRedesign">
        <Section name="Beep">
          <Parameter name="enabled" value="true"/>
        </Section>
        <Section name="UserInterface">
          <Parameter name="horizontalPos" value="0"/>
          <Parameter name="rows" value="2"/>
          <Parameter name="rows1" value="2"/>
          <Parameter name="rows2" value="2"/>
          <Parameter name="rows3" value="2"/>
          <Parameter name="columns" value="1"/>
          <Parameter name="columns1" value="1"/>
          <Parameter name="columns2" value="1"/>
          <Parameter name="columns3" value="1"/>
          <Parameter name="heldCells" value="2"/>
          <Parameter name="heldCells1" value="2"/>
          <Parameter name="heldCells2" value="2"/>
          <Parameter name="heldCells3" value="2"/>
          <Parameter name="orderItemFont" value="Arial-BOLD-19"/>
          <Parameter name="orderItemFont1" value="Arial-BOLD-19"/>
          <Parameter name="orderItemFont2" value="Arial-BOLD-19"/>
          <Parameter name="orderItemFont3" value="Arial-BOLD-19"/>
          <Parameter name="grillItemFont" value="Arial-BOLD-17"/>
          <Parameter name="grillItemFont1" value="Arial-BOLD-17"/>
          <Parameter name="grillItemFont2" value="Arial-BOLD-17"/>
          <Parameter name="grillItemFont3" value="Arial-BOLD-17"/>
          <Parameter name="orderItemVoidedFont" value="Arial-REGULAR-19"/>
          <Parameter name="orderItemVoidedFont1" value="Arial-REGULAR-19"/>
          <Parameter name="orderItemVoidedFont2" value="Arial-REGULAR-19"/>
          <Parameter name="orderItemVoidedFont3" value="Arial-REGULAR-19"/>
          <Parameter name="grillItemVoidedFont" value="Arial-REGULAR-17"/>
          <Parameter name="grillItemVoidedFont1" value="Arial-REGULAR-17"/>
          <Parameter name="grillItemVoidedFont2" value="Arial-REGULAR-17"/>
          <Parameter name="grillItemVoidedFont3" value="Arial-REGULAR-17"/>
          <Parameter name="firstThreshold" value="50"/>
          <Parameter name="secondThreshold" value="60"/>
          <Parameter name="displayGrillInstruction" value="ASIMAGE"/>
          <Parameter name="displaySideStatus" value="false"/>
          <Parameter name="displayDestinationImage" value="true"/>
          <Parameter name="displaySaleType" value="false"/>
          <Parameter name="displayOrderAmount" value="false"/>
          <Parameter name="groupMultiOrder" value="false"/>
          <Parameter name="showClock" value="false"/>
          <Parameter name="displaySideIndicator" value="false"/>
          <Parameter name="failoverFrontColor" value="BLACK"/>
          <Parameter name="pendingOrdersAlertFrontColor" value="BLACK"/>
          <Parameter name="heldOrdersAlertFrontColor" value="BLACK"/>
          <Parameter name="kvsStatusFont" value="Arial-REGULAR-1"/>
          <Parameter name="width" value="1024"/>
        </Section>
        <Section name="WayOfWork">
          <Parameter name="enableKVSProductFiltering" value="true"/>
          <Parameter name="KVSProductFilteringScript" value="filterSmallMonitor@GrillScriptC.nps"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true"/>
        <Adaptor name="npAdpKeyboardBumpBar" imports="npAdpKeyboardBumpBar" startonload="true"/>
        <Adaptor name="keyboard.bumpbar" imports="keyboard.bumpbar" startonload="true"/>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true"/>
      </Adaptors>
    </Service>
	<Service name="1010" type="NPW" classname="" startonload="true" quitOnFail="true">
				<Configuration imports="LocalWebView">
					<Section name="BaseHosts">
						<Parameter name="Urls" value="http://localhost:8123/npsharp" />
					</Section>
					<Section name="Log">
						<Parameter name="EnableDebug" value="true" />
						<Parameter name="logfilefolder" value="out/KVS1010" />
					</Section>
					<Section name="Component.Browser.KVS1010">
						<Parameter name="Position" value="0,0" />
						<Parameter name="ShowFrame" value="true" />
						<Parameter name="Urn" value="KVS/KVS1010" />
						<Parameter name="ShowCursor" value="true" />
						<Parameter name="Size" value="800x600" />
						<Parameter name="showCloseButton" value="true" />
						<Parameter name="allowResize" value="true" />
						<Parameter name="windowMaximized" value="false" />
						<Parameter name="canMoveWindow" value="true" />
						<Parameter name="AutoFocus" value="false" />
						<!--Coordinator Config-->
						<Parameter name="NodeName" value="KVS1010"/>
						<Parameter name="LogicalName" value="KVS1010"/>
						<Parameter name="InjectJavascriptCode" value="ClickPOSButtonHelper,MessageHubResponseHelper" />	<!--Coordinator Config-->
					</Section>
					<Section name="Component.DriverHost.BumpBar1010">
						<Parameter name="DriverFile" value="SerialBumpBar" />
						<Parameter name="DeviceType" value="BumpBar" />
						<Parameter name="LogicalName" value="BumpBar RTMS1" />
						<Parameter name="NodeName" value="KVS1010" />
						<Parameter name="AdapterFile" value="LegacyBumpBarAdapter" />
						<Parameter name="portname" value="COM1" />
						<Parameter name="baudrate" value="1200" />
						<Parameter name="databits" value="8" />
						<Parameter name="stopbits" value="1" />
						<Parameter name="timeout" value="20000" />
					</Section>
				</Configuration>
			</Service>
  </Services>
</PosDB>
