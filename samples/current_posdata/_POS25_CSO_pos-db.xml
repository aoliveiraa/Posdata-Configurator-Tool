<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all">
    <StoreProfile>
      <BusinessLimits>
        <ReductionValidationMode>Off</ReductionValidationMode>
      </BusinessLimits>
    </StoreProfile>
  </StoreDB>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="OperationMode">
      <Parameter name="AllowZeroPriceOrder" value="true"/>
      <Parameter name="applyUpdateOperationMode" value="1"/>
    </Section>
    <Section name="NPScripts">
      <Parameter name="posScriptCommands"/>
      <Parameter name="posCoinDispenser"/>
      <Parameter name="posCSOBusComp"/>
      <Parameter name="scriptCommands" value="BusinessComponentsCSO.nps"/>
      <Parameter name="scriptCommandsLocal" value="BusinessComponentsCSOLocal.nps"/>
    </Section>
    <Section name="OrderNumber">
      <Parameter name="PosIdFormat" value="0"/>
      <Parameter name="OrderNumberBigger" value="1"/>
      <Parameter name="OrderIdFormat" value="00"/>
      <Parameter name="OrderNumberSeperator"/>
      <Parameter name="OrderNumberFormat" value="2"/>
      <Parameter name="FirstReceiptEmpty" value="0"/>
    </Section>
    <Section name="Security">
      <Parameter name="managerAuthorization" value="login"/>
    </Section>
    <Section name="CLR_Promotion">
      <Parameter name="IsActive" value="false"/>
    </Section>
    <!-- <Section name="Cashless"> -->
    <!-- <Parameter name="enableEndOfDayReport" value="true"/> -->
    <!-- <Parameter name="KioskMode" value="1"/> -->
    <!-- <Parameter name="Server_IP" value="10.166.101.198"/> -->
    <!-- <Parameter name="Client_IP" value="10.166.101.198"/> -->
    <!-- </Section> -->
    <Section name="Kiosk">
      <Parameter name="PrinterStatusCheckOff" value="1"/>
    </Section>
    <Section name="OrbMatch">
      <Parameter name="ShowORBNumberOnReceipt" value="true"/>
    </Section>
  </Configuration>
  <Services>
    <Service name="25" type="POS" classname="npPOS.dll" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="WAY">
          <Member name="300" alias=""/>
        </UsedService>
        <UsedService serviceType="PSW">
          <Member name="300" alias=""/>
        </UsedService>
        <UsedService serviceType="RPR">
          <Member name="0025" alias=""/>
          <Member name="0004" alias=""/>
          <Member name="0003" alias=""/>
          <Member name="1013" alias=""/>
          <Member name="1023" alias=""/>
          <Member name="1033" alias=""/>
          <Member name="1043" alias=""/>
        </UsedService>
        <UsedService serviceType="PST">
          <Member name="8000" alias="PRODMAIN"/>
          <Member name="8001" alias="PRODBACK"/>
        </UsedService>
      </UsedServices>
      <Configuration imports="POS">
        <Section name="Cash">
          <Parameter name="initialFloat" value="0"/>
          <Parameter name="OverringBehaviour" value="0"/>
        </Section>
        <Section name="UserInterface">
          <Parameter name="PrintBigNumber" value="true"/>
        </Section>
        <Section name="PosType">
          <Parameter name="POD" value="CSO"/>
          <Parameter name="RemPOD" value="CSO"/>
        </Section>
        <Section name="CSO.UserInterface">
          <Parameter name="isNGK" value="true"/>
          <Parameter name="requireCardFirst" value="false"/>
          <Parameter name="foundationalMobileCheckin.enable" value="true"/>
          <Parameter name="Tender.allowZeroTotalOrderAlways" value="true"/>
          <!-- SSC for Ungated Scan -->
          <Parameter name="ungatedScan.barCodeTypes" value="MobileOrder|DigitalOffers"/>
          <Parameter name="ungatedScan.scanOffersAfterMobile" value="true"/>
          <Parameter name="coupon.globalMaxVoucherPerOrder" value="2"/>
        </Section>
        <Section name="OperationMode">
          <Parameter name="AutomaticOperatorLogin" value="true"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="standard.ui" imports="standard.ui" startonload="true">
          <Section name="main">
            <Parameter name="drivername" value="npGUIExt.dll"/>
            <Parameter name="actionPort" value="888"/>
            <Parameter name="eventPort" value="999"/>
            <Parameter name="cmdTPUI" value="../NGK/npKiosk.exe npActionListener=127.0.0.1:%d npEventListener=127.0.0.1:%d"/>
          </Section>
        </Adaptor>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true">
          <Section name="main">
            <Parameter name="url" value="http://10.166.101.71:8080/goform/RPC2"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpPrd" imports="npAdpPrd" startonload="true">
          <Section name="main">
            <Parameter name="SendOrder" value="ONPAID"/>
          </Section>
        </Adaptor>
        <Adaptor name="tlog" imports="tlog" startonload="true"/>
        <Adaptor name="npCLayer" imports="npCLayer" startonload="true"/>
        <Adaptor name="nps.extension.CloseLoopRedemption" imports="nps.extension.CloseLoopRedemption" startonload="true">
          <Section name="driverconfig">
            <Parameter name="IsCSO" value="1"/>
          </Section>
        </Adaptor>
        <Adaptor name="standard.account" imports="standard.account" startonload="true"/>
      </Adaptors>
    </Service>
    <Service name="25" type="RPR" startonload="true" quitOnFail="true">
      <Adaptors>
        <Adaptor name="npAdpRpr" imports="npAdpRpr" startonload="true">
          <Section name="main">
            <Parameter name="portname" value="RPR0025.txt"/>
            <Parameter name="drivername" value="npSerPrn.dll"/>
            <Parameter name="escSeq" value="printerTMControlChar_WINCOR_DE.properties"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
    <Service name="0025" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO"/>
    </Service>
  </Services>
</PosDB>
