      </UsedServices>
      <Configuration imports="POS">
        <Section name="Account">
          <Parameter name="AcceptZeroPricePMix" value="true" />
        </Section>
        <Section name="UserInterface">
          <Parameter name="frameWidth" value="1024" />
          <Parameter name="frameHeight" value="768" />
          <Parameter name="DDTSupport" value="true" />
          <Parameter name="SRMActive" value="false" />
          <Parameter name="doubleCrewStatus" value="false" />
          <Parameter name="showCloseButton" value="true" /> 
          <Parameter name="showCursor" value="true" />
        </Section>
        <Section name="OperationMode">
          <Parameter name="autoRecall" value="false" />
        </Section>
        <Section name="PosType">
          <Parameter name="POD" value="DRIVE_THRU" />
          <Parameter name="RemPOD" value="DRIVE_THRU" />
        </Section>
        <Section name="Report">
          <Parameter name="DualPoint" value="false" />
        </Section>
        <Section name="InactiveDimension">
          <Parameter name="buttonState" value="disable" />
        </Section>
        <Section name="SmartRouting">
          <Parameter name="podBlackListException" value="false" />
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="standard.ui" imports="standard.ui" startonload="true" />
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true">
          <Section name="main">
            <Parameter name="url" value="http://127.0.0.1:8080/goform/RPC2" />
          </Section>
        </Adaptor>
        <Adaptor name="tlog" imports="tlog" startonload="true" />
        <Adaptor name="standard.account" imports="standard.account" startonload="true" />
        <!-- keyboard scanner is no longer allowed in .36 <Adaptor name="keyboard.scanner" imports="keyboard.scanner" startonload="true" /> -->
        <Adaptor name="npAdpScanner" imports="npAdpScanner" startonload="true">
          <Section name="main">
            <Parameter name="service" value="npAdpScanner.dll" />
            <Parameter name="adaptorname" value="npAdpScanner" />
            <Parameter name="isNpSharp" value="true" />
            <Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll" />
            <Parameter name="hostAddress" value="localhost" />
            <Parameter name="portNumber" value="8123" />
            <Parameter name="logicalname" value="Scanner4" />
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
