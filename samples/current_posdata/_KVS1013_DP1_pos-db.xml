<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="OperationMode">
      <Parameter name="applyUpdateOperationMode" value="1"/>
    </Section>
    <Section name="PrintOnServe">
      <Parameter name="DuplicateReceiptWithBarCode" value="0"/>
      <Parameter name="Picklist" value="1"/>
      <Parameter name="DuplicateReceipt" value="0"/>
      <Parameter name="PicklistWithBarCode" value="1"/>
    </Section>
    <Section name="OrderNumber">
      <Parameter name="PosIdFormat" value="0"/>
      <Parameter name="OrderNumberBigger" value="1"/>
      <Parameter name="OrderIdFormat" value="00"/>
      <Parameter name="OrderNumberSeperator"/>
      <Parameter name="OrderNumberFormat" value="2"/>
      <Parameter name="FirstReceiptEmpty" value="0"/>
    </Section>
    <Section name="PrintFromKioskOnCounter">
      <Parameter name="PosIdFormat" value="0"/>
      <Parameter name="OrderNumberFormat" value="2"/>
      <Parameter name="OrderIdFormat" value="00"/>
      <Parameter name="OrderNumberSeperator" value=""/>
    </Section>
  </Configuration>
  <Services>
    <Service name="1013" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="RPR">
          <Member name="1013" alias=""/>
        </UsedService>
      </UsedServices>
      <Configuration imports="KVSRedesign">
        <Section name="UserInterface">
          <Parameter name="groupMultiOrder" value="false"/>
        </Section>
        <Section name="WayOfWork">
          <Parameter name="printReceiptOnServe" value="true"/>
        </Section>
        <Section name="TouchScreen">
          <Parameter name="button5_Click" value="toggleSideOnOff"/>
          <Parameter name="cell_Click" value="globalserve"/>
          <Parameter name="available" value="true"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true">
          <Section name="main">
            <Parameter name="url" value="http://127.0.0.1:8080/goform/RPC2"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true">
          <Section name="main">
            <Parameter name="kvsUIPort" value="1013"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true"/>
        <Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="true">
          <Section name="main">
            <Parameter name="globalserve" value="0xe1"/>
            <Parameter name="recall" value="0xa1"/>
            <Parameter name="print" value="0xa2"/>
            <Parameter name="next" value="0xb1"/>
            <Parameter name="previous" value="0xb2"/>
            <Parameter name="home" value=""/>
            <Parameter name="serveheld" value=""/>
            <Parameter name="heldscroll" value="0xe2"/>
            <Parameter name="undo" value=""/>
            <Parameter name="held" value="0xd2"/>
            <Parameter name="zoom" value="0xd1"/>
            <Parameter name="SideOn" value="0xc2"/>
            <Parameter name="SideOff" value="0xc1"/>
            <Parameter name="portname" value="virtual"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
    <Service name="1013" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO"/>
    </Service>
    <Service name="1013" type="RPR" classname="npRPR.dll" startonload="true" quitOnFail="true">
      <Adaptors>
        <Adaptor name="npAdpRpr" imports="npAdpRpr" startonload="true">
          <Section name="main">
            <Parameter name="portname" value="RPR1013.txt"/>
            <Parameter name="escSeq" value="printerTMControlChar_STAR.properties"/>
            <Parameter name="logicalname" value="Printer1"/>
            <Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll"/>
            <Parameter name="isNpSharp" value="true"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
  </Services>
</PosDB>
