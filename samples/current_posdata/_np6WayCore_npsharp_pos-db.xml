      <Adaptors>
        <Adaptor name="npAdpPSW" imports="npAdpPSW" startonload="true" />
        <Adaptor name="npAdpProductPricing" imports="npAdpDataExport" startonload="true">
          <Section name="ProductPricing">
            <Parameter name="enable" value="true" />
            <Parameter name="targetPath" value="./ProductPricing" />
          </Section>
        </Adaptor>
        <Adaptor name="npAdpPubl" startonload="true">
          <Section name="main">
            <Parameter name="service" value="npAdpPubl.dll" />
            <Parameter name="adaptorname" value="npAdpPubl" />
            <Parameter name="drivername" value="npDrvPubl.dll" />
            <Parameter name="driverbasename" value="npDrvPubl" />
            <Parameter name="logicalname" value="Publisher adaptor" />
            <Parameter name="loaddriver" value="EVT|MNI|PRD" />
            <Parameter name="TLDdir" value="C:\newpos\TLD" />
            <Parameter name="productionlist" value="FC|DT|MCC|FCE|DTE|MFY|FRY|CBS" />
          </Section>
        </Adaptor>
        <Adaptor name="npAdpTLD" startonload="true">
          <Section name="main">
            <Parameter name="adaptorname" value="npAdpTLD" />
            <Parameter name="drivername" value="npTLDEng.dll" />
            <Parameter name="service" value="npAdpTLD.dll" />
            <Parameter name="subscribers" value="EVT|MNI|PRD" />
            <Parameter name="outdir" value="C:\newpos\STLD" />
            <Parameter name="tmpdir" value="C:\newpos\STLD\TEMP" />
          </Section>
        </Adaptor>
        <Adaptor name="standard.account" imports="standard.account" startonload="true" />
        <Adaptor name="npAdpApplyUpdate" imports="npAdpApplyUpdate" startonload="true">
          <Section name="NonMandatoryTransaction">
            <Parameter name="nodes" value="KVS*|PRODSEC" />
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
