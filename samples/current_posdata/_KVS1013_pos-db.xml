					<Parameter name="orderItemVoidedFont1" value="Arial-REGULAR-15"/>
					<Parameter name="orderItemVoidedFont2" value="Arial-REGULAR-15"/>
					<Parameter name="orderItemVoidedFont3" value="Arial-REGULAR-15"/>
					<Parameter name="grillItemVoidedFont" value="Arial-REGULAR-14"/>
					<Parameter name="grillItemVoidedFont1" value="Arial-REGULAR-14"/>
					<Parameter name="grillItemVoidedFont2" value="Arial-REGULAR-14"/>
					<Parameter name="grillItemVoidedFont3" value="Arial-REGULAR-14"/>
