					<Parameter name="printPickListOnRunnerServe" value="true"/>
				</Section>
				<Section name="EnhancedBumpByTouch">
					<Parameter name="enhancedBumpByTouchEnable" value="false"/>
				</Section>
				<Section name="Touchscreen">
					<Parameter name="available" value="true"/>
					<Parameter name="buttons" value="9"/>
					<Parameter name="cell_Click" value="runnerServe"/>
					<Parameter name="enable" value="true"/>
					<Parameter name="button1_Click" value="runnerServe"/>
					<Parameter name="button2_Click" value="runnernext"/>
					<Parameter name="button3_Click" value="recall"/>
					<Parameter name="button4_Click" value="sideOn"/>
					<Parameter name="button5_Click" value="sideOff"/>
					<Parameter name="button6_Click" value="zoom"/>
					<Parameter name="button7_Click" value="runnerHeld"/>
					<Parameter name="button8_Click" value="serveheld"/>
					<Parameter name="button9_Click" value="heldscroll"/>
				</Section>
			</Configuration>
			<Adaptors>
				<Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
				<Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true"/>
				<Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="false">
					<Section name="main">
						<Parameter name="logicalname" value=""/>
						<Parameter name="isNpSharp" value="true"/>
						<Parameter name="drivername" value="NpSharp.Driver.HttpDrivers.dll"/>
						<Parameter name="hostAddress" value="localhost"/>
						<Parameter name="portNumber" value="8123"/>
					</Section>
				</Adaptor>
			</Adaptors>
		</Service>
		<Service name="1013" type="NPW" classname="" startonload="true" quitOnFail="true">
				<Configuration imports="LocalWebView">
					<Section name="BaseHosts">
