<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all" />
  <ColorDB imports="default" />
  <Configuration imports="Store.wide">
    <Section name="OperationMode">
      <Parameter name="applyUpdateOperationMode" value="1" />
    </Section>
    <Section name="NPScripts">
      <Parameter name="posScriptCommands" />
      <Parameter name="posCoinDispenser" />
      <Parameter name="posCSOBusComp" />
      <Parameter name="scriptCommands" value="BusinessComponents.nps" />
      <Parameter name="scriptCommandsLocal" value="BusinessComponentsLocal.nps" />
    </Section>
    <Section name="OrderNumber">
      <Parameter name="PosIdFormat" value="0" />
      <Parameter name="OrderNumberBigger" value="1" />
      <Parameter name="OrderIdFormat" value="00" />
      <Parameter name="OrderNumberSeperator" />
      <Parameter name="OrderNumberFormat" value="2" />
      <Parameter name="FirstReceiptEmpty" value="0" />
    </Section>
    <Section name="Security">
      <Parameter name="managerAuthorization" value="login" />
    </Section>
    <Section name="OrbMatch">
      <Parameter name="ShowORBNumberOnReceipt" value="false" />
    </Section>
  </Configuration>
  <Services>
    <Service name="04" type="POS" classname="npPOS.dll" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="WAY">
          <Member name="300" alias="" />
        </UsedService>
        <UsedService serviceType="PSW">
          <Member name="300" alias="" />
        </UsedService>
        <!-- <UsedService serviceType="RPR">
					<Member name="0004" alias=""/>
					<Member name="0005" alias=""/>
					<Member name="0025" alias=""/>
					<Member name="0003" alias=""/>
					<Member name="1013" alias=""/>
					<Member name="1023" alias=""/>
					<Member name="1033" alias=""/>
					<Member name="1043" alias=""/>
				</UsedService> -->
        <UsedService serviceType="PST">
          <Member name="8000" alias="PRODMAIN" />
          <Member name="8001" alias="PRODBACK" />
        </UsedService>
        <UsedService serviceType="KVS">
          <Member name="1070" alias="KVS ORB1 1070" />
          <Member name="1071" alias="KVS MINIORB1 1071" />
          <Member name="1002" alias="KVS MCC 1002" />
          <Member name="1004" alias="KVS MFYM 1004" />
          <Member name="1003" alias="KVS DT 1003" />
          <Member name="1007" alias="KVS DRKDES 1007" />
          <Member name="1008" alias="KVS DRKDESM 1008" />
          <Member name="1001" alias="KVS MFY 1001" />
          <Member name="1011" alias="KVS MFY 1011" />
          <Member name="1013" alias="KVS DP 1013" />
          <Member name="1023" alias="KVS DP 1023" />
          <Member name="1033" alias="KVS OAT 1033" />
          <Member name="1043" alias="KVS OAT 1043" />
