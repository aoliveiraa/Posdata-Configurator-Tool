      <Configuration imports="POS">
        <Section name="UserInterface">
          <Parameter name="doubleCrewStatusFC" value="false" />
          <Parameter name="frameWidth" value="1024" />
          <Parameter name="frameHeight" value="768" />
        </Section>
        <Section name="PosType">
          <Parameter name="POD" value="FRONT_COUNTER" />
          <Parameter name="RemPOD" value="FRONT_COUNTER" />
        </Section>
        <Section name="OperationMode">
          <Parameter name="restartAfterOpen" value="false" />
          <Parameter name="autoRecall" value="false" />
          <Parameter name="enableMobileOrdering" value="true" />
          <Parameter name="isHtmlUi" value="true" />
        </Section>
        <Section name="WorkflowHttpServer">
          <Parameter name="port" value="8123" />
          <Parameter name="prefix" value="POS0004" />
        </Section>
      </Configuration>
      <Adaptors AutomationIdentifier="POS_Adaptor">
        <Adaptor name="standard.ui" imports="standard.ui" startonload="true">
          <Section name="main">
            <Parameter name="drivername" value="npGuiSharp.dll" />
          </Section>
        </Adaptor>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true">
          <Section name="main">
            <Parameter name="url" value="http://127.0.0.1:8080/goform/RPC2" />
          </Section>
        </Adaptor>
        <Adaptor name="tlog" imports="tlog" startonload="true" />
        <Adaptor name="npCLayer" imports="npCLayer" startonload="true" />
        <Adaptor name="standard.account" imports="standard.account" startonload="true" />
        <!--<Adaptor name="DSLDevDrv.cardreader2" imports="DSLDevDrv.cardreader2" startonload="true"/>-->
        <Adaptor name="keyboard.scanner" imports="keyboard.scanner" startonload="false" />
        <Adaptor name="nps.extension.CloseLoopRedemption" imports="nps.extension.CloseLoopRedemption" startonload="true" />
        <!--<Adaptor name="DSLDevDrv.linedisplay2" imports="DSLDevDrv.linedisplay2" startonload="true"/>-->
        <Adaptor name="virtual.linedisplay" imports="virtual.linedisplay" startonload="false" />
      </Adaptors>
    </Service>
    <Service type="RPR" classname="com.ngpos.arch.services.printer.core.PrinterController" startonload="true" quitOnFail="true" name="0004">
      <Adaptors>
        <Adaptor name="npAdpRpr" imports="npAdpRpr" startonload="true">
          <Section name="main">
            <Parameter name="drivername" value="virtualPrinter.dll" />
            <Parameter name="portname" value="..\RPR_4__POS04_pos-db.xml.txt" />
            <Parameter name="escSeq" value="printerControlChar.properties" />
            <Parameter name="fileAppend" value="true" />
            <Parameter name="flush" value="false" />
            <Parameter name="overwrite" value="true" />
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
    <Service type="NPW" startonload="false" quitOnFail="true" classname="LocalWebView" name="04">
      <Configuration imports="LocalWebView">
        <Section name="BaseHosts">
          <Parameter name="Urls" value="http://127.0.0.1:8123/npsharp" />
        </Section>
        <Section name="LocalWebView">
          <Parameter name="Location" value="../NpWebView" />
        </Section>
        <Section name="Log">
          <Parameter name="EnableDebug" value="true" />
          <Parameter name="LogFileFolder" value="out/" />
          <Parameter name="enableConsoleLog" value="true" />
        </Section>
        <Section name="AutoUpdate">
          <Parameter name="EnableAutoUpdate" value="true" />
        </Section>
        <Section name="Monitoring.Memory">
          <Parameter name="MonitoringInterval" value="60000" />
          <Parameter name="MaxMemoryPercentage" value="70" />
          <Parameter name="LauncherLimit" value="200" />
          <Parameter name="BrowserLimit" value="1500" />
          <Parameter name="DriverHostLimit" value="1500" />
        </Section>
        <Section name="Component.Browser.Kiosk">
          <Parameter name="Position" value="0,0" />
          <Parameter name="Urn" value="POS/POS0004" />
          <Parameter name="Zoom" value="100" />
          <Parameter name="ShowFrame" value="true" />
          <Parameter name="showCursor" value="true" />
          <Parameter name="Size" value="1024x768" />
          <Parameter name="BrowserServer" value="messagehub" />
          <!--Coordinator Config-->
          <Parameter name="NodeName" value="POS0004" />
          <Parameter name="LogicalName" value="POS0004" />
          <Parameter name="InjectJavascriptCode" value="ClickPOSButtonHelper,MessageHubResponseHelper" />
          <!--Coordinator Config-->
        </Section>
        <Section name="Component.DriverHost.Scanner">
          <Parameter name="DriverFile" value="SerialScanner.dll" />
          <Parameter name="DeviceType" value="Scanner" />
          <Parameter name="LogicalName" value="Scanner1" />
          <Parameter name="NodeName" value="POS0004" />
          <Parameter name="AdapterFile" value="LegacyScannerAdapter" />
          <Parameter name="portname" value="virtual" />
        </Section>
        <Section name="Component.DriverHost.RPR0004">
          <Parameter name="DriverFile" value="npWinPrn.dll" />
          <Parameter name="DeviceType" value="Printer" />
          <Parameter name="LogicalName" value="POS_04_Printer" />
          <Parameter name="NodeName" value="RPR0004" />
          <Parameter name="AdapterFile" value="LegacyPrinterAdapter.dll" />
          <Parameter name="portname" value="USBprinter" />
        </Section>
      </Configuration>
    </Service>
    <Service name="301" type="FOE" classname="npfoe.dll" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="WAY">
          <Member name="300" alias="" />
        </UsedService>
        <UsedService serviceType="PST">
          <Member name="8002" alias="" />
          <Member name="8013" alias="" />
        </UsedService>
      </UsedServices>
      <Configuration imports="FOE">
        <Section name="main">
          <Parameter name="ShowConsoleWindow" value="false" />
          <Parameter name="PriceDiffThreshold" value="3.00" />
          <Parameter name="FC" value="ONRECALL" />
          <Parameter name="ValidateRPSState" value="true" />
        </Section>
        <Section name="podNameMapping">
          <Parameter name="FC" value="FOE0016" />
          <Parameter name="CK" value="FOE0019" />
          <Parameter name="CURB" value="FOE0019" />
        </Section>
        <Section name="routing">
          <Parameter name="podSource" value="FC;FC;CK;CK" />
          <Parameter name="paidStatus" value="PAID;NOTPAID;PAID;NOTPAID" />
          <Parameter name="targetStoreArea" value="FC;FC;FC;FC" />
          <Parameter name="orderNumberPrefix" value="16;16;19;19" />
        </Section>
        <Section name="productionMonitors">
          <Parameter name="FC" value="ONPAID" />
          <Parameter name="CK" value="ONPAID" />
          <Parameter name="DT" value="ONTOTAL" />
        </Section>
        <Section name="expoMonitors">
          <Parameter name="FC" value="ONPAID" />
          <Parameter name="CK" value="ONPAID" />
          <Parameter name="DT" value="ONTOTAL" />
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="foe.xmlrpc" imports="foe.xmlrpc" startonload="true">
          <Section name="main">
            <Parameter name="port" value="8088" />
            <Parameter name="uri" value="RPC2" />
            <Parameter name="httpLogName" value="../out/http.log" />
            <Parameter name="httpLogTrace" value="false" />
          </Section>
        </Adaptor>
        <Adaptor name="virtual.linedisplay" imports="virtual.linedisplay" startonload="true">
          <Section name="main">
            <Parameter name="LoadDriver" value="RCD" />
          </Section>
        </Adaptor>
        <Adaptor name="standard.account" imports="standard.account" startonload="true">
          <Section name="main">
            <Parameter name="drivername" value="npAccTax.dll" />
          </Section>
          <Section name="tax">
            <Parameter name="drivername" value="npAccTax.dll" />
          </Section>
        </Adaptor>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true" />
      </Adaptors>
