<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="OperationMode">
      <Parameter name="applyUpdateOperationMode" value="1"/>
    </Section>
	<Section name="Messaging">
	  <Parameter name="networkAdaptorBaseIp" vau="10.118.57.25" />
    </Section>
  </Configuration>
  <Services>
    <Service name="1011" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <Configuration imports="KVSRedesign">
        <Section name="Beep">
          <Parameter name="beepOnNewOrder" value="FIRST"/>
        </Section>
        <Section name="UserInterface">
          <Parameter name="groupMultiOrder" value="false"/>
        </Section>
        <Section name="TouchScreen">
          <Parameter name="available" value="true"/>
          <Parameter name="enable" value="true"/>
          <Parameter name="cell_Click" value="serve"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true"/>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true">
          <Section name="main">
            <Parameter name="kvsUIPort" value="1011"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true" />
        <Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="true">
          <Section name="main">
            <Parameter name="serve" value="0xe1" />
            <Parameter name="recall" value="0xa1" />
            <Parameter name="print" value="0xa2" />
            <Parameter name="next" value="0xb1" />
            <Parameter name="previous" value="0xb2" />
            <Parameter name="home" value="" />
            <Parameter name="serveheld" value="" />
            <Parameter name="heldscroll" value="0xe2" />
            <Parameter name="undo" value="" />
            <Parameter name="held" value="0xd2" />
            <Parameter name="zoom" value="0xd1" />
            <Parameter name="SideOn" value="0xc2" />
            <Parameter name="SideOff" value="0xc1" />
            <Parameter name="portname" value="virtual" />
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
	 <Service name="1011" type="KVS" classname="npKVS.dll" startonload="true" quitOnFail="true">
      <Configuration imports="KVSRedesign">
        <Section name="UserInterface">
          <Parameter name="groupMultiOrder" value="false"/>
        </Section>
        <Section name="TouchScreen">
          <Parameter name="available" value="true"/>
          <Parameter name="enable" value="true"/>
          <Parameter name="cell_Click" value="serve"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="npAdpKvsComm" imports="npAdpKvsComm" startonload="true"/>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true">
          <Section name="main">
            <Parameter name="url" value="http://127.0.0.1:8080/goform/RPC2"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsUI" imports="npAdpKvsUI" startonload="true">
          <Section name="main">
            <Parameter name="kvsUIPort" value="1011"/>
          </Section>
        </Adaptor>
        <Adaptor name="npAdpKvsSound" imports="npAdpKvsSound" startonload="true"/>
        <Adaptor name="npAdpBumpBar" imports="npAdpBumpBar" startonload="true">
          <Section name="main">
            <Parameter name="serve" value="0xe1"/>
            <Parameter name="recall" value="0xa1"/>
            <Parameter name="print" value="0xa2"/>
            <Parameter name="next" value="0xb1"/>
            <Parameter name="previous" value="0xb2"/>
            <Parameter name="home" value=""/>
            <Parameter name="serveheld" value=""/>
            <Parameter name="heldscroll" value="0xe2"/>
            <Parameter name="undo" value=""/>
            <Parameter name="held" value="0xd2"/>
            <Parameter name="zoom" value="0xd1"/>
            <Parameter name="SideOn" value="0xc2"/>
            <Parameter name="SideOff" value="0xc1"/>
            <Parameter name="portname" value="virtual"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
	<Service name="1011" type="NPW" classname="" startonload="true" quitOnFail="true">
			<Configuration imports="LocalWebView">
				<Section name="BaseHosts">
					<Parameter name="Urls" value="http://127.0.0.1:8123/npsharp/" />
				</Section>
				<Section name="LocalWebView">
					<Parameter name="Location" value="../npwebview" />
					<Parameter name="ConfigurationFileName" value="WebViewConfig.xml" />
				</Section>
				<Section name="Log">
					<Parameter name="EnableDebug" value="true" />
					<Parameter name="LogFileFolder" value="out/"/>
				</Section>
				<Section name="AutoUpdate">
					<Parameter name="EnableAutoUpdate" value="true" />
				</Section>
				<Section name="Monitoring">
					<Parameter name="MonitorInterval" value="60000" />
				</Section>
				<Section name="Monitoring.Memory">
					<Parameter name="MaxMemoryPercentage" value="80" />
					<Parameter name="LauncherLimit" value="200" />
					<Parameter name="BrowserLimit" value="1500" />
					<Parameter name="DriverHostLimit" value="1500" />
				</Section>
				
				<Section name="Component.Browser.KVS1011">
					<!-- <Parameter name="Position" value="1024,0"/> -->
					<Parameter name="ShowFrame" value="true"/>
					<Parameter name="Urn" value="KVS/KVS1011"/>
					<Parameter name="ShowCursor" value="true"/>
					<Parameter name="Size" value="1024x768"/>
					<Parameter name="BrowserServer" value="messagehub"/> <!--Coordinator Config-->
					<Parameter name="NodeName" value="KVS1011"/>
					<Parameter name="LogicalName" value="KVS1011"/>
					<Parameter name="InjectJavascriptCode" value="ClickPOSButtonHelper,MessageHubResponseHelper" />	<!--Coordinator Config-->						
				</Section>
				<Section name="Component.DriverHost.Scanner">
					<Parameter name="DriverFile" value="SerialScanner.dll"/>
					<Parameter name="DeviceType" value="Scanner"/>
					<Parameter name="LogicalName" value="Scanner61"/>
					<Parameter name="NodeName" value="KVS1011"/>
					<Parameter name="AdapterFile" value="LegacyScannerAdapter"/>
					<Parameter name="portname" value="virtual"/>
				</Section>
			</Configuration>	
	</Service>	
    <Service name="1011" type="GPR" classname="npRPR.dll" startonload="true" quitOnFail="true">
      <Adaptors>
        <Adaptor name="npAdpRpr" imports="npAdpRpr" startonload="true">
          <Section name="main">
            <Parameter name="portname" value="GPR1011.txt" />
            <Parameter name="escSeq" value="printerTMControlChar_STAR.properties" />
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
    <Service name="1011" type="STO" classname="npUpdtRcv.dll" startonload="false" quitOnFail="true">
      <Configuration imports="STO">
        <Section name="main">
          <Parameter name="NodeType" value="KVS"/>
        </Section>
      </Configuration>
    </Service>
  </Services>
</PosDB>
