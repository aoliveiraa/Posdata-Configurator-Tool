      <Parameter name="enableChargeForUpchargeWhenPromo" value="true"/>
      <Parameter name="enableExtraChargeWhenPromo" value="true"/>
    </Section>
  </Configuration>
  <Services>
    <Service name="09" type="POS" classname="com.ngpos.pos.NewPOS" startonload="true" quitOnFail="true">
      <UsedServices>
        <UsedService serviceType="WAY">
          <Member name="0300" alias=""/>
        </UsedService>
        <UsedService serviceType="PSW">
          <Member name="0300" alias=""/>
        </UsedService>
        <UsedService serviceType="PST">
          <Member name="8001" alias=""/>
