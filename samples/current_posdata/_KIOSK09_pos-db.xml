          <Parameter name="showCursor" value="true"/>
          <Parameter name="allowResize" value="true"/>
          <Parameter name="alwaysOnTop" value="false"/>
          <Parameter name="isNGK" value="true"/>
        </Section>
        <Section name="SmartRouting">
          <Parameter name="podBlackListException" value="false"/>
        </Section>
      </Configuration>
      <Adaptors>
        <Adaptor name="nps.xmlrpc" imports="nps.xmlrpc" startonload="true"/>
        <Adaptor name="npAdpPrd" imports="npAdpPrd" startonload="true">
          <Section name="main">
            <Parameter name="SendOrder" value="ONPAID"/>
          </Section>
        </Adaptor>
        <Adaptor name="standard.ui" imports="standard.ui" startonload="true">
          <Section name="main">
            <Parameter name="drivername" value="npGuiSharp.dll"/>
            <!-- <Parameter name="drivername" value="npGUIExt.dll"/> -->
            <!-- <Parameter name="_drivername" value="npDrvGUI.dll"/> -->
            <!-- <Parameter name="actionPort" value="888"/> -->
            <!-- <Parameter name="eventPort" value="999"/> -->
            <!-- <Parameter name="cmdTPUI" value="../NGK/npKiosk.exe"/> -->
          </Section>
        </Adaptor>
        <Adaptor name="xmlrpccli" imports="xmlrpccli" startonload="true"/>
        <Adaptor name="tlog" imports="tlog" startonload="true"/>
        <Adaptor name="standard.account" imports="standard.account" startonload="true"/>
      </Adaptors>
    </Service>
    <Service name="09" type="STO" classname="npUpdtRcv.dll" startonload="true" quitOnFail="true">
      <Configuration imports="STO"/>
    </Service>
    <Service name="09" type="RPR" classname="npRPR.dll" startonload="true" quitOnFail="true">
      <Adaptors>
        <Adaptor name="npAdpRpr" imports="npAdpRpr" startonload="true">
          <Section name="main">
            <Parameter name="drivername" value="npSerPrn.dll"/>
            <Parameter name="portname" value="POS009.txt"/>
            <Parameter name="printHiddenData" value="false"/>
            <Parameter name="baudrate" value="115200"/>
            <Parameter name="utf8table" value="Utf8ToAnsi.txt"/>
          </Section>
        </Adaptor>
      </Adaptors>
    </Service>
  </Services>
</PosDB>
