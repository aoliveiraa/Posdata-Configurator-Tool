<?xml version="1.0" encoding="utf-8"?>
<PosDB>
  <StoreDB imports="all"/>
  <ColorDB imports="default"/>
  <Configuration imports="Store.wide">
    <Section name="NPScripts">
      <!-- <Parameter name="scriptCommands" value="BusinessComponentsCSO.nps"/> -->
