        </UsedService>
        <UsedService serviceType="KVS">
          <Member name="1001" alias="MFY1 - [1001]"/>
          <Member name="1002" alias="MFY2 - [1002]"/>
          <Member name="1003" alias="FC - [1003]"/>
          <Member name="1004" alias="CBS - [1004]"/>
          <Member name="1005" alias="FRY - [1005]"/>
          <Member name="1006" alias="GM - [1006]"/>
          <Member name="1007" alias="DT - [1007]"/>
          <Member name="1008" alias="DT - [1008]"/>
          <Member name="1009" alias="CP-A - [1009]"/>
          <Member name="1010" alias="CP-B - [1010]"/>
          <Member name="1011" alias="FC Assembly - [1011]"/>
        </UsedService>
      </UsedServices>
      <Configuration imports="POS">
        <Section name="WorkflowHttpServer">
          <Parameter name="port" value="8123"/>
          <Parameter name="prefix" value="POS0009"/>
        </Section>
        <Section name="TestHelper">
          <Parameter name="load" value="true"/>
          <Parameter name="port" value="1498"/>
        </Section>
        <Section name="Account">
          <Parameter name="AcceptZeroPricePMix" value="true"/>
        </Section>
        <Section name="UserInterface">
          <!-- <Parameter name="frameWidth" value="1080"/> -->
          <!-- <Parameter name="frameHeight" value="1920"/> -->
          <Parameter name="DDTSupport" value="false"/>
          <Parameter name="SRMActive" value="false"/>
          <Parameter name="doNotShowInGrillScreen" value="40000003"/>
          <Parameter name="doubleCrewStatus" value="true"/>
        </Section>
        <Section name="OperationMode">
          <Parameter name="autoRecall" value="false"/>
          <Parameter name="AutomaticOperatorLogin" value="true"/>
          <Parameter name="AnonymousOperatorID" value="3"/>
          <Parameter name="AnonymousOperatorName" value="Carl Sagan"/>
          <Parameter name="DisplayPrinterListOnError" value="false"/>
          <Parameter name="isHtmlUi" value="true"/>
        </Section>
        <Section name="PosType">
          <Parameter name="POD" value="CSO"/>
          <Parameter name="RemPOD" value="FRONT_COUNTER"/>
        </Section>
        <Section name="Report">
          <Parameter name="DualPoint" value="true"/>
        </Section>
        <Section name="InactiveDimension">
          <Parameter name="buttonState" value="disable"/>
        </Section>
        <Section name="CSO">
          <Parameter name="networkCheckServices" value="QUE1000"/>
        </Section>
        <Section name="CSO.UserInterface">
          <Parameter name="order.EatingPaymentScreenLocationMode" value="2"/>
