          <Parameter name="enableOffers" value="true"/>
          <Parameter name="tender.allowZeroTotalOrderAlways" value="true"/>
          <Parameter name="clamshell.platen.1.name" value="MSG_CLAMSHELL_PLTN_1"/>
          <Parameter name="clamshell.platen.2.name" value="MSG_CLAMSHELL_PLTN_2"/>
